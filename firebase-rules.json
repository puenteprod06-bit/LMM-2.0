{
  "rules": {
    "licencias": {
      "$licenciaId": {
        ".read":  "auth !== null && $licenciaId === auth.uid",
        ".write": "auth !== null && auth.token.email === root.child('config/adminEmail').val()"
      }
    },
    "config": {
      ".read":  "auth !== null && auth.token.admin === true",
      ".write": "auth !== null && auth.token.admin === true"
    },
    "$other": {
      ".read":  false,
      ".write": false
    }
  }
}