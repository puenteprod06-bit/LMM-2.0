# SOLO para un proyecto Supabase desechable de validación V8. NUNCA producción.
# Copia este archivo a .env.isolated y rellena los valores. .env.isolated está ignorado por Git.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Project Settings -> Database -> Connection string (modo Direct o Session).
# Si la contraseña tiene caracteres especiales, codifícalos en URL (%40, %23, etc.).
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU-PROYECTO.supabase.co:5432/postgres

# Opcional: solo si hace falta firmar JWT propios (Project Settings -> API -> JWT secret).
# SUPABASE_JWT_SECRET=TU_JWT_SECRET
