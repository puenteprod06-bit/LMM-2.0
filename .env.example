# CONFIGURACIÓN LOCAL — completar con valores propios antes de ejecutar.
# Esta es una PLANTILLA SIN SECRETOS. Copiar a `.env` y rellenar con credenciales propias.
# Nunca subir `.env` con valores reales al repositorio (está en .gitignore).

# Firebase (opcional — solo si se usa login/recuperación de Firebase)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
ADMIN_EMAIL=

# Sincronización V8 / Supabase (opcional — solo si se vincula la nube)
# Ejemplos sin valor real; rellenar con los datos del propio proyecto Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Interruptor de inventario V8 (apagado por defecto)
LMM_INVENTORY_SYNC_V8=0

# Puerto del servidor local
PORT=3000

# Token opcional para restablecimiento de contraseña
RESET_TOKEN=
