{
  "name": "la-mente-maestra",
  "version": "2.3.2",
  "description": "Gestión Gastronómica - Sistema POS para Restaurantes",
  "main": "main.js",
  "author": "Puenteprod",
  "scripts": {
    "start": "electron .",
    "bump:patch": "npm version patch",
    "bump:minor": "npm version minor",
    "bump:major": "npm version major",
    "rebuild": "electron-rebuild -f -w better-sqlite3,bcrypt",
    "minify:css": "node build/minify-css.js",
    "minify:js": "node build/minify-js.js",
    "minify": "npm run minify:css && npm run minify:js",
    "dist": "npm run rebuild && npm run minify && electron-builder --win --x64",
    "test": "node scripts/run-tests.js --testPathPattern=tests/ --forceExit",
    "validate:v8-sql": "node scripts/validate-v8-sql.js",
    "validate:v8-migration": "node scripts/run-tests.js tests/v8-migration.test.js --forceExit",
    "migrate:v8-local": "node scripts/v8-migrate-local.js",
    "validate:v8-supabase": "node scripts/validate-v8-supabase.js",
    "validate:v8-concurrency": "node scripts/validate-v8-supabase-concurrency.js",
    "test:watch": "node scripts/run-tests.js --testPathPattern=tests/ --watch",
    "test:coverage": "node scripts/run-tests.js --testPathPattern=tests/ --coverage --forceExit",
    "release": "npm run rebuild && npm run minify && electron-builder --win --x64 --publish always",
    "backup:zip": "node scripts/make-backup-zip.js"
  },
  "build": {
    "appId": "com.puenteprod.lmm",
    "productName": "La Mente Maestra",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/bcrypt/**",
      "node_modules/bindings/**",
      "node_modules/node-gyp-build/**",
      "node_modules/escpos-usb/**",
      "node_modules/usb/**",
      "node_modules/prebuild-install/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "public"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "db.js",
      "auth.js",
      "sync-engine.js",
      "seeds/**/*",
      "logger.js",
      "validator.js",
      "printer-modules.js",
      "package.json",
      "routes/**/*",
      "services/**/*",
      "middleware/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".env.runtime",
        "to": ".env"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/Logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "warningsAsErrors": false,
      "include": "build/installer.nsh",
      "license": "build/license.txt",
      "installerSidebar": "build/sidebar.bmp",
      "installerHeader": "build/header.bmp"
    },
    "publish": {
      "provider": "github",
      "owner": "puenteprod06-bit",
      "repo": "LMM",
      "private": false
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.7.0",
    "body-parser": "^1.20.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.3.9",
    "escpos": "^3.0.0-alpha.6",
    "escpos-usb": "^3.0.0-alpha.4",
    "express": "^4.22.1",
    "express-rate-limit": "^8.5.1",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electron/rebuild": "^3.7.2",
    "cssnano": "^7.0.6",
    "electron": "33.0.0",
    "electron-builder": "24.13.3",
    "electron-rebuild": "^3.2.9",
    "glob": "^11.0.0",
    "jest": "^29.7.0",
    "pg": "^8.16.3",
    "postcss": "^8.4.47",
    "supertest": "^7.0.0",
    "terser": "^5.36.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 15000,
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/",
      "/build/",
      "/public/"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
